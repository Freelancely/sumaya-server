# ── Server ───────────────────────────────────────────────────────
PORT="4000"
HOST="0.0.0.0"
# Set to true ONLY when something else terminates the connection (nginx, a load
# balancer, Fly/Render/Railway). It makes the server believe `x-forwarded-for`,
# which is the address every rate limit is counted against — trusting it while
# directly exposed lets any caller spoof it.
TRUST_PROXY="false"
# debug | info | warn | error | silent
LOG_LEVEL="info"

# ── Database ─────────────────────────────────────────────────────
# A long-running process holds a real pool, so this is a plain Postgres URL —
# Neon's pooled endpoint, RDS, or a container. DIRECT_URL is only for
# migrations, which issue statements a pooler cannot proxy.
DATABASE_URL="postgresql://user:password@localhost:5432/sumaya"
DIRECT_URL=""
# Keep the total across all replicas under the server's max_connections.
DATABASE_POOL_MAX="10"

# ── JWT ───────────────────────────────────────────────────────────
# Two DIFFERENT secrets, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# Seconds. Access tokens are short because they cannot be revoked individually;
# the refresh cookie carries the long-lived session.
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="2592000"

# ── Image storage ─────────────────────────────────────────────────
# cloudinary | memory. `memory` keeps uploads in the process and loses them on
# restart — for local work only; production refuses to start on it.
STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sumaya/pieces"

# ── Email ─────────────────────────────────────────────────────────
# resend | console | memory. Unset: Resend when RESEND_API_KEY is present,
# otherwise the console, which prints password-reset links to the terminal.
MAIL_DRIVER=""
RESEND_API_KEY=""
MAIL_FROM="Sumaya Atelier <no-reply@sumayahmurafie.com>"

# ── App ───────────────────────────────────────────────────────────
# Public origin of the SPA. Password reset links are built from it.
APP_URL="http://localhost:8080"
# Comma-separated CORS allowlist — every origin the SPA is served from.
# Defaults to APP_URL when unset.
CORS_ORIGINS="http://localhost:8080,http://localhost:3000"

# Off is rejected in production. See README for what each endpoint allows.
RATE_LIMITS_ENABLED="true"

# ── First superadmin (used by `npm run db:seed`) ──────────────────
# Read only by the seed script. Delete SUPERADMIN_PASSWORD once you have signed
# in and changed it.
SUPERADMIN_EMAIL="atelier@sumayahmurafie.com"
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Sumaya"
